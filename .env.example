# Fieldwise — Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Host and Port Configuration
PORT=8000
HOST=0.0.0.0

# Optional Google Maps Platform Places API (New) Key
# When provided, Fieldwise prioritizes Google Places API (New) for location search,
# place details, and autocomplete. When omitted, Fieldwise automatically and seamlessly
# uses its robust OpenStreetMap (Nominatim + Photon + Overpass) pipeline.
# Enable in Google Cloud Console: "Places API (New)" and "Geocoding API".
GOOGLE_MAPS_API_KEY=your_google_maps_places_api_key_here

# Small Language Model Configuration (<= 3B Parameters Mandate)
# Recommended starting choice: Qwen/Qwen2.5-1.5B-Instruct (1.54B parameters)
# Alternative: Qwen/Qwen2.5-3B-Instruct
GEOAI_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct

# Set to 1 to load SLM weights into local memory for PyTorch inference
# Set to 0 to use deterministic evidence-grounded synthesis (recommended for quick evaluation without GPU)
GEOAI_LOAD_SLM=0

# Frontend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional Hugging Face Token for publishing model card repository
# HF_TOKEN=hf_your_token_here
# HF_REPO_ID=your-username/fieldwise-geoai-slm
